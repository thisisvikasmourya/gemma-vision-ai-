				"to": "00:00:17,300"
			},
			"offsets": {
				"from": 15020,
				"to": 17300
			},
			"text": " So what does super hard mean?"
		},
		{
			"timestamps": {
				"from": "00:00:17,300",
				"to": "00:00:22,220"
			},
			"offsets": {
				"from": 17300,
				"to": 22220
			},
			"text": " Well, when my brother and I were starting our first company, instead of getting an apartment,"
		},
